# Telegram
TELEGRAM_TOKEN=your-telegram-bot-token
ALLOWED_TELEGRAM_USER_ID=123456789

# WordPress
WP_USER=your-wordpress-username
WP_APP_PASSWORD=your-wordpress-application-password
WP_INTERNAL_URL=http://wordpress
WP_CONTAINER=tensoredge-publisher-wordpress-1

# Ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral-small
OLLAMA_WRITE_MODEL=mistral-small

# Database (used by docker-compose)
MYSQL_ROOT_PASSWORD=change-me-strong-password

# Cloudflare Tunnel (optional — remove tunnel service if not using)
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
